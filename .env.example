# Copy to .env for local runs. docker-compose supplies its own values.
ACP_DATABASE_URL=postgresql+psycopg://acp:acp@localhost:5434/acp
ACP_LOG_LEVEL=INFO
ACP_LOG_FORMAT=json

# Timing knobs are SERVER-authoritative: workers fetch them at registration
# so the whole fleet can be retuned without a redeploy. See docs/ARCHITECTURE.md
ACP_LEASE_TTL_S=30
ACP_LEASE_RENEW_INTERVAL_S=7
ACP_HEARTBEAT_INTERVAL_S=5
ACP_WORKER_DEAD_AFTER_S=15
ACP_REAPER_PERIOD_S=1
ACP_POLL_INTERVAL_MS=250
ACP_CLAIM_BATCH_SIZE=5

# Tests use their own database so a failed run never eats your dev data.
ACP_TEST_DATABASE_URL=postgresql+psycopg://acp:acp@localhost:5434/acp_test
